# Neon Postgres connection string (Vercel Marketplace → Storage → Neon)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Admin login password (orice string, va fi cel pe care îl tastează clientul)
ADMIN_PASSWORD=schimba-aceasta-parola

# Secret pentru semnarea cookie-ului de sesiune (orice string lung și aleatoriu)
ADMIN_AUTH_SECRET=genereaza-un-string-aleatoriu-lung-aici

# Resend — trimitere emailuri de confirmare (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Adresa expeditor (trebuie să fie pe un domeniu verificat în Resend)
EMAIL_FROM=Quasar Dance <noreply@websitefactory.ro>
# Inbox-ul care primește notificările de la formularul de contact
CONTACT_INBOX=contact@quasardance.ro

# (Opțional) Google Analytics 4 — se încarcă DOAR dacă e setat, cu Consent Mode v2.
# Lasă gol până clientul oferă ID-ul de măsurare (format G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
