# Neon Postgres connection string (Vercel Marketplace → Storage → Neon)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Admin login password (orice string, va fi cel pe care îl tastează clientul)
ADMIN_PASSWORD=schimba-aceasta-parola

# Secret pentru semnarea cookie-ului de sesiune (orice string lung și aleatoriu)
ADMIN_AUTH_SECRET=genereaza-un-string-aleatoriu-lung-aici
